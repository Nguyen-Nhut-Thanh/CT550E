NODE_ENV=development

# PostgreSQL used by Prisma
DATABASE_URL="postgresql://postgres:12345@localhost:5432/CT550E?schema=public"

# MongoDB reserved for documents, logs, or future AI workloads
MONGODB_URI="mongodb://localhost:27017/CT550E"

# Application endpoints
API_PORT=4000
API_HOST=127.0.0.1
API_INTERNAL_URL="http://127.0.0.1:4000"
API_PUBLIC_URL="https://api.nhutthanh.id.vn"
FRONTEND_PUBLIC_URL="https://nhutthanh.id.vn"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://nhutthanh.id.vn,https://www.nhutthanh.id.vn"
# Set API_INTERNAL_URL in apps/web/.env too. Browsers use same-origin /api.
AI_PORT=8000

# VNPay sandbox. Keep credentials in .env only; never use NEXT_PUBLIC_ for keys.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="https://nhutthanh.id.vn/api/payment/vnpay-return"
VNP_EXPIRE_MINUTES=15
# Register https://nhutthanh.id.vn/api/payment/vnpay-ipn with VNPay.
