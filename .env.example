# Copy this file to .env in the repository root and fill in your credentials.
# Web, API, Prisma and import scripts share that one file.
# Restart running services after editing .env. Shell variables take precedence.
# NEXT_PUBLIC_ values are public; never put secrets there.

# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Optional isolated Next.js build directory; defaults to .next.
NEXT_BUILD_DIR=

# Application endpoints
API_HOST=127.0.0.1
API_PORT=4000
API_INTERNAL_URL="http://127.0.0.1:4000"
API_PUBLIC_URL="http://localhost:4000"
FRONTEND_PUBLIC_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# Optional email-link URL.
APP_URL=

# Browser configuration
# HTTP requests use same-origin /api; sockets use the public API origin below.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_AI_BASE="http://localhost:8000"

# Database (PostgreSQL / Prisma)
DATABASE_URL="postgresql://postgres:change-me@localhost:5432/CT550E?schema=public"

# Authentication
JWT_SECRET="replace-with-a-long-random-secret"
# Expiry in seconds.
JWT_EXPIRES_IN=604800
GOOGLE_CLIENT_ID=

# Cloudinary
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# Email
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="JourniTrip"
# Optional internal recipient; defaults to MAIL_USER.
MAIL_INTERNAL_EMAIL=

# VNPay sandbox
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAYMENT_URL="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VNP_RETURN_URL="http://localhost:3000/api/payment/vnpay-return"
VNP_EXPIRE_MINUTES=15
# Register <FRONTEND_PUBLIC_URL>/api/payment/vnpay-ipn with VNPay.

# AI service
AI_HOST=127.0.0.1
AI_PORT=8000
OPENAI_API_KEY=
