{
  "name": "travel-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run prisma:generate --workspace=database",
    "db:push": "npm run prisma:push --workspace=database",
    "db:import:provinces": "tsx scripts/import-data/import-provinces.ts",
    "db:import:seasonal": "tsx scripts/import-data/import-seasonal-showcase.ts",
    "db:backfill:booking-metadata": "tsx scripts/backfill-booking-metadata.ts",
    "grant-admin": "tsx scripts/grant-admin.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.2.2"
  },
  "packageManager": "npm@11.5.2"
}
