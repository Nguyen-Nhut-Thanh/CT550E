{
  "name": "travel-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run prisma:generate --workspace=database",
    "db:amenities": "node scripts/apply-tour-amenities.cjs",
    "db:schedule-amenities": "node scripts/apply-schedule-amenities.cjs",
    "test:schedule-amenities": "tsx --tsconfig apps/api/tsconfig.json scripts/test-schedule-amenities.ts",
    "db:tour-summary-cleanup": "node scripts/apply-tour-summary-cleanup.cjs",
    "test:amenities": "tsx --tsconfig apps/api/tsconfig.json scripts/test-tour-amenities.ts",
    "db:itinerary": "node scripts/apply-itinerary-activities.cjs",
    "test:itinerary": "tsx --tsconfig apps/api/tsconfig.json scripts/test-itinerary-activities.ts",
    "db:push": "npm run prisma:push --workspace=database",
    "db:membership": "node scripts/apply-membership.cjs",
    "db:departures": "node scripts/apply-schedule-departures.cjs",
    "db:workforce": "node scripts/apply-workforce.cjs",
    "db:flexible-crew": "node scripts/apply-flexible-crew.cjs",
    "db:deputy-leader": "node scripts/apply-deputy-leader.cjs",
    "test:departures": "tsx --tsconfig apps/api/tsconfig.json scripts/test-schedule-departures.ts",
    "test:workforce": "tsx --tsconfig apps/api/tsconfig.json scripts/test-workforce.ts",
    "test:workforce:http": "node scripts/test-workforce-http.cjs",
    "db:import:provinces": "tsx scripts/import-data/import-provinces.ts",
    "grant-admin": "tsx scripts/grant-admin.ts"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "dotenv": "^17.2.2",
    "lucide-react": "^1.52.0",
    "passport-strategy": "^1.0.0"
  },
  "packageManager": "npm@11.5.2"
}
