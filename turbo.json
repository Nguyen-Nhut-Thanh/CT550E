{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV", "DATABASE_URL", "API_*", "FRONTEND_PUBLIC_URL", "CORS_ORIGINS",
    "HOST", "PORT", "AI_*", "JWT_*", "GOOGLE_*", "NEXT_PUBLIC_*", "NEXT_BUILD_DIR",
    "OPENAI_API_KEY", "CLOUDINARY_*", "MAIL_*", "APP_URL", "VNP_*"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "prisma:generate": {
      "cache": false
    },
    "prisma:push": {
      "cache": false
    }
  }
}
